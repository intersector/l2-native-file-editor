{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "L2 File Editor",
  "version": "0.1.0",
  "identifier": "gr.blackthym.l2fileeditor.tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "L2 File Editor",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "license": "MIT",
    "shortDescription": "Lineage II client file editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../Sources/L2FileEditorApp/Resources/DAT_defs/": "DAT_defs/",
      "../../Sources/L2FileEditorApp/Resources/chronicles.json": "chronicles.json"
    },
    "fileAssociations": [
      {
        "ext": ["dat", "ini", "int", "htm"],
        "name": "Lineage II client file",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "linux": {
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
